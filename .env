OUTPUT="output/can_compiled.v"
# Passed to the testbench as -DVCD_FILE so $dumpfile() in testbench/can_tb.v
# writes here -- the same path the script then hands to gtkwave.
VCD_FILE="output/dump_wav.vcd"

# Directories scanned for *.v at compile time. Add modules to src/ and they
# get picked up automatically -- no need to edit script.cmd.
SRC_DIR="src"
TB_DIR="testbench"
